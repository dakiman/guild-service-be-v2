APP_NAME="WoW Guild Service"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_PORT=80

FRONTEND_URL=http://localhost:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=guild_service
DB_USERNAME=guild_service
DB_PASSWORD=secret

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=guild_

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@guild-service.com"
MAIL_FROM_NAME="${APP_NAME}"

# Blizzard API
BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=

# Staleness thresholds (seconds)
BLIZZARD_STALE_CHARACTER_PROFILE=900
BLIZZARD_STALE_CHARACTER_MYTHIC=1800
BLIZZARD_STALE_CHARACTER_EQUIPMENT=900
BLIZZARD_STALE_GUILD_BASIC=3600
BLIZZARD_STALE_GUILD_ROSTER=7200

# Minimum character level to sync from guild roster
BLIZZARD_MIN_LEVEL_FOR_LOOKUP=70

# Override automatic season detection (leave empty for auto)
BLIZZARD_MYTHIC_SEASON_OVERRIDE=

# Horizon
HORIZON_PREFIX=guild_horizon:

# API rate limiting (requests per minute)
API_RATE_LIMIT=60
